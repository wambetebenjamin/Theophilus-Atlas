# Theophilus Atlas environment contract
# Copy to .env.local for local work. Every value here is optional: the site
# degrades to a light, static, cookie respectful experience without them.

# Public site address, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=https://theophilus-atlas.vercel.app

# WhatsApp contact, digits only, no plus sign
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
NEXT_PUBLIC_WHATSAPP_DISPLAY=+254 112 272 061

# Light auth (next-auth). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=

# Google reCAPTCHA on the contact form. Leave empty to fall back to the
# local human confirmation checkbox, which needs no third party script.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_VERSION=v3
RECAPTCHA_SECRET_KEY=

# Optional contact delivery. Without this the form stays honest: the note is
# handed to WhatsApp instead of being stored or emailed by the site.
CONTACT_WEBHOOK_URL=

# Locales shipped by the switcher
NEXT_PUBLIC_LOCALES=en,sw,fr
